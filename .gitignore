# VersePro v2 runtime artifacts
v2/backend/.env
v2/backend/*.db
v2/backend/*.sqlite*
v2/backend/data/vosk-model*/
v2/backend/data/whisper_models/
# semantic/ : modèles et caches ignorés, SAUF les index pré-calculés livrés
# avec l'application (actifs produit, requis par le build CI).
v2/backend/data/semantic/*
!v2/backend/data/semantic/index-*.npz
!v2/backend/data/semantic/index-*.json
# bibles_cache/ : les traductions sous copyright (Semeur, TOB/oecuménique, NBS,
# Français courant) restent LOCALES — jamais publiées. Seule la KJF (domaine
# public) est versionnée ; `python cache_bibles.py` régénère les autres.
v2/backend/data/bibles_cache/*
!v2/backend/data/bibles_cache/kjf.json
v2/backend/venv/
v2/frontend/node_modules/
v2/frontend/dist/

# Tests
.pytest_cache/
.coverage
htmlcov/
*.pyc
__pycache__/

# Tauri
v2/frontend/src-tauri/target/

# Empaquetage backend (artefacts générés, jamais versionnés)
v2/backend/.freeze-venv/
v2/backend/build/
v2/backend/dist/
v2/backend/data/versepro.db
v2/backend/*.db
v2/frontend/src-tauri/binaries/
v2/frontend/src-tauri/backend/
v2/backend/dist-onefile/
v2/release/
# Schémas générés par Tauri v2 (capabilities)
v2/frontend/src-tauri/gen/

# Corpus de rejeu : les enregistrements ne sont JAMAIS versionnés.
# Ils captent la voix du prédicateur et de l'assemblée, et restent sur la
# machine qui les a produits. Seuls les cas.json — transcript et référence
# attendue — sont partagés. Voir v2/backend/corpus/README.md.
v2/backend/corpus/cas/**/audio.wav
v2/backend/corpus/**/*.wav

# Modèles ASR locaux (Nemotron, sherpa…) — 2,7 Go de binaires téléchargés à la
# demande par le logiciel. Ils ne doivent JAMAIS entrer dans le dépôt : GitHub
# refuse au-delà de 100 Mo, et un blob poussé une fois reste dans l'historique.
v2/backend/data/models/
*.gguf

# Binaires natifs compilés à la main pendant l'exploration. En temps normal ce
# dossier n'existe pas : la bibliothèque ASR arrive par la roue
# transcribe-cpp-native, une par plateforme.
v2/backend/bin/

# Clones de sources natives explorés pendant l'intégration ASR.
v2/backend/tmp/transcribe_src/
v2/backend/tmp/parakeet_src/

# Sorties de travail : transcriptions, extraits audio, rapports d'écoute.
# Elles contiennent de la parole d'assemblée — voir corpus/README.md.
v2/backend/tmp/

# Essais jetables laissés à la racine du backend pendant l'exploration.
v2/backend/scratch_test*.py
