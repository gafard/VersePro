{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "VersePro",
  "version": "2.1.0",
  "identifier": "app.versepro.regie",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "",
    "devUrl": "http://localhost:3010",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "VersePro — Régie de projection",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 700,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri:; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' asset: http://asset.localhost data: blob: http://127.0.0.1:17871; media-src 'self' asset: http://asset.localhost blob:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:17871 ws://127.0.0.1:17871; frame-src 'self' http://127.0.0.1:17871; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "copyright": "© 2026 Selah Studios",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "backend"
    ],
    "longDescription": "VersePro écoute la prédication, détecte les références et citations bibliques en temps réel et pilote la projection (écran secours, OBS, vMix, ProPresenter). Un produit Selah Studios.",
    "shortDescription": "Régie de projection biblique en direct — Selah Studios",
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZCQTc3QUNDNjZBQjI5RjgKUldUNEthdG16SHFuKy9kMEF1dTh3Mmx5N1pmdUtBYUdjT29iQ2k3ZnE2b0h1TUxXRGJYak5UbjUK",
      "endpoints": [
        "https://github.com/gafard/VersePro/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
