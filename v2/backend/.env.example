# VersePro v2 - Configuration

# Deepgram API (obtenir sur https://deepgram.com)
# Inscription gratuite: 200$ de crédit offert
DEEPGRAM_API_KEY=

# Modèle Deepgram (nova-2 = meilleur, nano = plus rapide)
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=fr
DEEPGRAM_SMART_FORMAT=true

# Agent IA semantique optionnel
# L'IA propose des references en file manuelle, elle ne projette jamais directement.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
AI_AGENT_ENABLED=true
AI_CONFIDENCE_THRESHOLD=95
OPENROUTER_MODEL=google/gemini-2.5-flash
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ProPresenter
PROPRESENTER_HOST=127.0.0.1
PROPRESENTER_PORT=12345
PROPRESENTER_AUTO_CONNECT=true
PROPRESENTER_AUTO_SEND=false

# Application
DEBUG=true
BIBLE_VERSION=LSG
VALIDATE_REFERENCES=true
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Securite reseau : jeton requis pour les clients distants (LAN).
# Les clients locaux (127.0.0.1) et l'ecran de projection restent libres.
# Generer un jeton : python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Cote client distant : en-tete "Authorization: Bearer <jeton>" ou "?token=<jeton>"
API_TOKEN=

# Audio
AUDIO_SAMPLE_RATE=16000
AUDIO_CHUNK_SIZE=4096

# Vosk local: small = plus leger, large = plus precis
VOSK_MODEL_TYPE=small
