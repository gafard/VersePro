# VersePro v2 - Configuration

# Deepgram API (obtenir sur https://deepgram.com)
DEEPGRAM_API_KEY=

# Modèle Deepgram (nova-2 = meilleur, nano = plus rapide)
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=fr
DEEPGRAM_SMART_FORMAT=true

# Agent IA semantique optionnel
# L'IA propose des references en file manuelle, elle ne projette jamais directement.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
AI_AGENT_ENABLED=true
AI_CONFIDENCE_THRESHOLD=95
OPENROUTER_MODEL=google/gemini-2.5-flash
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ProPresenter
PROPRESENTER_HOST=127.0.0.1
PROPRESENTER_PORT=12345
PROPRESENTER_AUTO_CONNECT=true
PROPRESENTER_AUTO_SEND=false
SUNDAY_SAFE_MODE=true
SHADOW_MODE=false

# Application
DEBUG=true
BIBLE_VERSION=LSG
VALIDATE_REFERENCES=true
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Securite reseau : jeton requis pour les clients distants (LAN).
# Les clients locaux (127.0.0.1) et l'ecran de projection restent libres.
# Generer un jeton : python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Cote client distant : en-tete "Authorization: Bearer <jeton>" ou "?token=<jeton>"
API_TOKEN=

# Audio
AUDIO_SAMPLE_RATE=16000
AUDIO_CHUNK_SIZE=4096
ASR_DEFAULT_ENGINE=auto

# Whisper local: auto choisit tiny/base/small selon la machine.
# Une fenetre de 2.4 s privilegie la robustesse; reduire augmente la reactivite
# mais peut couper les mots rapides.
WHISPER_MODEL=auto
WHISPER_COMPUTE_TYPE=int8
WHISPER_CHUNK_SECONDS=2.4
WHISPER_OVERLAP_SECONDS=0.25
WHISPER_BEAM_SIZE=1
WHISPER_AUTO_DOWNLOAD=false

# Vosk local: small = plus leger, large = plus precis
VOSK_MODEL_TYPE=small

# Retrieval semantique local ONNX, puis arbitrage LLM sur les seuls candidats.
LOCAL_SEMANTIC_ENABLED=true
# e5-base = modele de production (768 dim, ~265 Mo) ; e5-small sert de repli
# automatique quand la machine ne peut pas charger le premier.
LOCAL_SEMANTIC_MODEL=e5-base
LOCAL_SEMANTIC_FALLBACK=e5-small
# Seuil calibre par modele : ne pas le reprendre d'un autre encodeur, les
# echelles de similarite ne sont pas comparables.
LOCAL_SEMANTIC_THRESHOLD=0.8385
LOCAL_SEMANTIC_TOP_K=5
LOCAL_SEMANTIC_AUTO_DOWNLOAD=false
